{
	"name": "jan-made/mail-chimp",
	"description": "MailChimp integration into Nette framework",
	"keywords": [
		"nette",
		"mailChimp"
	],
	"type": "library",
	"license": "MIT",
	"authors": [
		{
			"name": "Jan Trejbal",
			"homepage": "https://github.com/jan-made"
		}
	],
	"replace": {
		"trejjam/mail-chimp": "self.version"
	},
	"require": {
		"php": "~8.4.0 || ~8.5.0",

		"composer/ca-bundle": "^1.5",
		"nette/di": "^3.2.6",
		"nette/utils": "^4.1",
		"guzzlehttp/guzzle": "^7.10",
		"tharos/schematic": "^1.5",
		"thecodingmachine/safe": "^2.5 | ^3.0.2"
	},
	"require-dev": {
		"nette/robot-loader": "^4.1",
		"nette/bootstrap": "^3.2",
		"tracy/tracy": "^2.9 || ^3.0",

		"nette/tester": "^2.6",

		"phpstan/phpstan": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"nepada/phpstan-nette-tester": "^2.0",
		"thecodingmachine/phpstan-safe-rule": "^1.3",
		"roave/no-floaters": "^1.13",

		"symplify/easy-coding-standard": "^13.1",

		"roave/security-advisories": "dev-master"
	},
	"suggest": {
		"tracy/tracy": "Logs rejected MailChimp requests through Tracy"
	},
	"autoload": {
		"psr-4": {
			"Trejjam\\MailChimp\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Trejjam\\MailChimp\\Tests\\": "tests/src/",
			"Trejjam\\MailChimp\\Tests\\Cases\\": "tests/cases/"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"config": {
		"sort-packages": true,
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "v0.8.x-dev"
		}
	}
}
